# Copy to deploy/.env on the server and fill in. Keep it secret.

# Domain pointing to this server (DNS A record), e.g. api.uzsl.uz
API_DOMAIN=api.example.uz

# Long random values: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
JWT_SECRET=

# Never true on a public server: it would return SMS codes in the API response
OTP_DEBUG=false

# Where the admin dashboard is opened from
CORS_ORIGINS=["https://admin.uzsl.uz"]

# Login codes by SMS (Eskiz.uz). SMS_OTP_TEMPLATE must be approved as a template in your Eskiz account.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_OTP_TEMPLATE=UzSL: tasdiqlash kodi {code}

FIREBASE_PROJECT_ID=uzsl-7cd39
MAX_UPLOAD_MB=50
