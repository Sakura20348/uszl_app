# Copy to .env and change for production
DATABASE_URL=postgresql+asyncpg://uzsl:uzsl@localhost:5432/uzsl

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","https://admin.uzsl.uz"]

# true = login codes are logged and returned in the response (no SMS provider yet). Set false in production.
OTP_DEBUG=true

# Google / Apple sign-in: OAuth client ids of the app (JSON list). Empty = turned off.
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=[]

# Push notifications: Firebase service account key (Firebase console > Project settings >
# Service accounts > Generate new private key). Keep the file secret. Empty = push off.
FCM_CREDENTIALS_FILE=

# Lessons: accuracy (%) needed to complete one, and XP per level
LESSON_PASS_ACCURACY=50
XP_PER_LEVEL=100

MEDIA_DIR=media
MAX_UPLOAD_MB=50

# Login codes by SMS through Eskiz.uz (empty = no SMS; with OTP_DEBUG=true codes show in the app instead)
SMS_PROVIDER=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Must match a template approved in your Eskiz account; {code} is replaced
SMS_OTP_TEMPLATE=UzSL: tasdiqlash kodi {code}
